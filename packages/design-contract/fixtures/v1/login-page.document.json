{
  "version": "1.0.0",
  "id": "login-document",
  "name": "登录页",
  "profile": { "id": "team-default", "version": "1.0.0", "digest": "sha256:team-default-v1" },
  "assets": {},
  "tokens": { "color.primary": "#1677ff" },
  "componentDefinitions": {
    "ui.button": {
      "id": "ui.button",
      "propsSchema": { "children": { "type": "string" } },
      "appearance": {
        "id": "button-appearance",
        "kind": "text",
        "text": "按钮",
        "typography": {}
      }
    }
  },
  "componentBindings": {
    "ui.button": {
      "componentRef": "ui.button",
      "target": "react-tailwind-antd",
      "codeBinding": { "importFrom": "antd", "exportName": "Button" }
    }
  },
  "pages": [
    {
      "id": "login-page",
      "name": "登录",
      "rootId": "login-root",
      "nodes": {
        "login-root": {
          "id": "login-root",
          "kind": "root",
          "parentId": null,
          "childIds": ["login-card"]
        },
        "login-card": {
          "id": "login-card",
          "kind": "frame",
          "parentId": "login-root",
          "layout": {
            "mode": "flex",
            "direction": "column",
            "gap": 16,
            "padding": { "top": 24, "right": 24, "bottom": 24, "left": 24 }
          },
          "layoutItem": { "width": { "mode": "fixed", "value": 360 } },
          "childIds": ["login-title", "submit"]
        },
        "login-title": {
          "id": "login-title",
          "kind": "text",
          "parentId": "login-card",
          "text": "欢迎登录",
          "typography": { "fontSize": 24 }
        },
        "submit": {
          "id": "submit",
          "kind": "component-instance",
          "parentId": "login-card",
          "componentRef": "ui.button",
          "variant": { "type": "primary" },
          "overrides": { "children": "登录" },
          "layoutItem": { "width": { "mode": "fill" } }
        }
      }
    }
  ]
}

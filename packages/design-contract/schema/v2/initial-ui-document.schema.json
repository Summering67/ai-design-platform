{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-design-platform.dev/schema/v2/initial-ui-document.schema.json",
  "title": "Initial UI Document v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "name", "assets", "root"],
  "properties": {
    "version": { "const": "1.0.0" },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1 },
    "assets": { "type": "object", "additionalProperties": { "$ref": "#/$defs/asset" } },
    "root": { "$ref": "#/$defs/node" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "jsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } }
      ]
    },
    "jsonObject": { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "src", "mimeType"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["image", "icon", "font", "file"] },
        "src": { "type": "string", "minLength": 1 },
        "mimeType": { "type": "string", "minLength": 1 },
        "alt": { "type": "string" }
      }
    },
    "style": { "$ref": "design-document.schema.json#/$defs/visualStyle" },
    "layoutIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role"],
      "properties": {
        "role": { "enum": ["page", "section", "navigation", "toolbar", "sidebar", "content", "list", "grid", "form", "field-group", "actions", "overlay"] },
        "grouping": { "enum": ["single", "collection", "paired", "cluster"] },
        "adaptivity": { "enum": ["preserve", "reflow", "condense"] },
        "density": { "enum": ["compact", "comfortable", "spacious"] }
      }
    },
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "name", "tag", "style", "props", "children"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "kind": { "enum": ["element", "text", "image", "component"] },
        "name": { "type": "string", "minLength": 1 }, "tag": { "type": "string", "minLength": 1 },
        "packageName": { "type": "string", "minLength": 1 }, "defaultModule": { "type": "boolean" },
        "style": { "$ref": "#/$defs/style" }, "layoutIntent": { "$ref": "#/$defs/layoutIntent" },
        "props": { "$ref": "#/$defs/jsonObject" }, "tokens": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }, "children": { "type": "array", "items": { "$ref": "#/$defs/node" } },
        "text": { "type": "string" }, "assetId": { "$ref": "#/$defs/id" }, "alt": { "type": "string" }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "text" } } }, "then": { "required": ["text"], "properties": { "children": { "maxItems": 0 } } } },
        { "if": { "properties": { "kind": { "const": "image" } } }, "then": { "required": ["assetId"], "properties": { "children": { "maxItems": 0 } } } },
        { "if": { "properties": { "kind": { "const": "component" } } }, "then": { "required": ["packageName"] } }
      ]
    }
  }
}

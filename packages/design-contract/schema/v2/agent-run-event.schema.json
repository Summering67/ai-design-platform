{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-design-platform.dev/schema/v2/agent-run-event.schema.json",
  "type": "object",
  "required": ["version", "event", "runId", "stage", "attempt"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": "2.0.0" },
    "event": { "enum": ["run", "stage", "progress", "result", "input_required", "failed", "cancelled"] },
    "runId": { "type": "string", "minLength": 1 },
    "taskId": { "type": "string", "minLength": 1 },
    "parentTaskId": { "type": ["string", "null"] },
    "stage": { "type": "string", "minLength": 1 },
    "attempt": { "type": "integer", "minimum": 1 },
    "payload": { "type": "object" }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-design-platform.dev/schema/v2/layout-plan.schema.json",
  "title": "Layout Plan v1",
  "type": "object", "additionalProperties": false,
  "required": ["version", "viewport", "operations"],
  "properties": {
    "version": { "const": "1.0.0" },
    "viewport": { "type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": { "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 } } },
    "operations": { "type": "array", "items": { "$ref": "#/$defs/operation" } }
  },
  "$defs": {
    "insets": { "type": "object", "additionalProperties": false, "properties": { "top": { "type": "number", "minimum": 0 }, "right": { "type": "number", "minimum": 0 }, "bottom": { "type": "number", "minimum": 0 }, "left": { "type": "number", "minimum": 0 } } },
    "sizing": { "oneOf": [
      { "type": "object", "additionalProperties": false, "required": ["mode", "value"], "properties": { "mode": { "const": "fixed" }, "value": { "type": "number", "minimum": 0 } } },
      { "type": "object", "additionalProperties": false, "required": ["mode"], "properties": { "mode": { "enum": ["fill", "hug"] } } },
      { "type": "object", "additionalProperties": false, "required": ["mode", "min"], "properties": { "mode": { "const": "minmax" }, "min": { "type": "number", "minimum": 0 }, "max": { "type": "number", "minimum": 0 } } }
    ] },
    "layout": { "type": "object", "additionalProperties": false, "required": ["mode"], "properties": { "mode": { "enum": ["flex", "absolute"] }, "direction": { "enum": ["row", "row-reverse", "column", "column-reverse"] }, "justifyContent": { "enum": ["flex-start", "flex-end", "center", "space-between", "space-around", "space-evenly"] }, "alignItems": { "enum": ["stretch", "flex-start", "flex-end", "center", "baseline"] }, "wrap": { "enum": ["nowrap", "wrap", "wrap-reverse"] }, "gap": { "type": "number", "minimum": 0 }, "rowGap": { "type": "number", "minimum": 0 }, "columnGap": { "type": "number", "minimum": 0 }, "padding": { "$ref": "#/$defs/insets" } } },
    "item": { "type": "object", "additionalProperties": false, "properties": { "width": { "$ref": "#/$defs/sizing" }, "height": { "$ref": "#/$defs/sizing" }, "flexGrow": { "type": "number", "minimum": 0 }, "flexShrink": { "type": "number", "minimum": 0 }, "flexBasis": { "oneOf": [{ "type": "number" }, { "type": "string" }, { "type": "boolean" }] }, "alignSelf": { "enum": ["auto", "flex-start", "flex-end", "center", "baseline", "stretch"] }, "margin": { "$ref": "#/$defs/insets" }, "position": { "enum": ["flow", "absolute"] }, "inset": { "$ref": "#/$defs/insets" } } },
    "responsive": { "type": "object", "additionalProperties": false, "properties": { "minWidth": { "type": "number", "minimum": 0 }, "maxWidth": { "type": "number", "minimum": 0 }, "direction": { "enum": ["row", "row-reverse", "column", "column-reverse"] }, "justifyContent": { "enum": ["flex-start", "flex-end", "center", "space-between", "space-around", "space-evenly"] }, "alignItems": { "enum": ["stretch", "flex-start", "flex-end", "center", "baseline"] }, "wrap": { "enum": ["nowrap", "wrap", "wrap-reverse"] }, "flexWrap": { "enum": ["nowrap", "wrap", "wrap-reverse"] }, "gap": { "type": "number", "minimum": 0 }, "rowGap": { "type": "number", "minimum": 0 }, "columnGap": { "type": "number", "minimum": 0 }, "padding": { "$ref": "#/$defs/insets" }, "layout": { "$ref": "#/$defs/layout" }, "layoutItem": { "$ref": "#/$defs/item" }, "sizing": { "enum": ["fixed", "fill", "hug", "minmax"] }, "visible": { "type": "boolean" } } },
    "operation": { "type": "object", "additionalProperties": false, "required": ["nodeId"], "properties": { "nodeId": { "type": "string", "minLength": 1 }, "layout": { "$ref": "#/$defs/layout" }, "layoutItem": { "$ref": "#/$defs/item" }, "responsive": { "type": "object", "additionalProperties": { "$ref": "#/$defs/responsive" } } }, "anyOf": [{ "required": ["layout"] }, { "required": ["layoutItem"] }, { "required": ["responsive"] }] }
  }
}

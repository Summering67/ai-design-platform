{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-design-platform.dev/schema/v2/codegen-request.schema.json",
  "title": "DesignDocument Codegen Request v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["document", "canvasImages"],
  "properties": {
    "document": { "$ref": "design-document.schema.json" },
    "canvasImages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "https://ai-design-platform.dev/schema/v2/codegen-request.schema.json#/$defs/canvasImage"
      }
    },
    "options": {
      "$ref": "https://ai-design-platform.dev/schema/v2/codegen-request.schema.json#/$defs/options"
    }
  },
  "$defs": {
    "canvasImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["viewportId", "width", "height", "mimeType", "image"],
      "properties": {
        "viewportId": { "type": "string", "minLength": 1, "maxLength": 120 },
        "width": { "type": "integer", "exclusiveMinimum": 0, "maximum": 10000 },
        "height": { "type": "integer", "exclusiveMinimum": 0, "maximum": 10000 },
        "mimeType": { "enum": ["image/png", "image/jpeg", "image/webp"] },
        "image": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "data"],
              "properties": {
                "kind": { "const": "base64" },
                "data": { "type": "string", "minLength": 1, "maxLength": 12000000 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "id"],
              "properties": {
                "kind": { "const": "ref" },
                "id": { "type": "string", "minLength": 1, "maxLength": 240 }
              }
            }
          ]
        }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "componentName": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$", "maxLength": 80 },
        "fileBaseName": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$", "maxLength": 80 }
      }
    }
  }
}

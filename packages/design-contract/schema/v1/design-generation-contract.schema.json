{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-design-platform.dev/schema/v1/design-generation-contract.schema.json",
  "type": "object",
  "required": ["profile", "nodeKinds", "tokens", "components", "layout", "icons"],
  "additionalProperties": false,
  "properties": {
    "profile": {
      "type": "object",
      "required": ["id", "version", "digest"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "minLength": 1 }
      }
    },
    "nodeKinds": { "type": "array", "items": { "type": "string" } },
    "tokens": { "type": "array", "items": { "type": "string" } },
    "components": { "type": "object" },
    "layout": { "type": "object" },
    "icons": { "type": "array", "items": { "type": "string" } }
  }
}
